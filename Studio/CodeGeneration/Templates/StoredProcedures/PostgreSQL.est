<% 
/*
=========================================================================
    EntitySpaces 2010 
    Persistence Layer and Business Objects for Microsoft .NET 
    Copyright 2005 - 2010 EntitySpaces, LLC 
    EntitySpaces(TM) is a legal trademark of EntitySpaces, LLC 
    http://www.entityspaces.net 

    This template is bound by the EntitySpaces License Agreement which 
    is located here:

    http://www.entityspaces.net/portal/License/tabid/97/Default.aspx
    
    Revision 2026.10.8
    ---------------------------------------------------------------------
    [FIX-A1] UPDATE SET clause now excludes IsSpecialColumn columns.
             Previously the signature excluded them but the SET clause
             included them, producing "column p_X does not exist".
    [FIX-A2] Version increment uses IsEsConcurrency heuristic (name
             based) because IColumn.IsEntitySpacesConcurrency is not
             populated at template time.
    [FIX-A3] DELETE now takes only PK columns, matching the provider
             when it is aligned to the same rule.
			 
	Known limitations :

	- Special columns are matched by hardcoded name (DateAdded,
	  DateModified, AddedBy, ModifiedBy) because the Studio metadata engine
	  does not expose the config to templates.
	- The concurrency column is detected by name heuristic (Version,
	  RowVersion, VersionNumber) for the same reason.
	- DELETE takes only PK columns; optimistic concurrency is not enforced
	  on DELETE.
=========================================================================
*/%>
<%@ TemplateInfo 
    UniqueID="26AF598A-4CF9-4b24-BB01-A71565959C0E"
	UserInterfaceID="D08B0E66-E1C9-446a-A40E-1DDA5DE00777"
    Title="PostgreSQL"   
    Description="PostgreSQL Stored Procedures" 
    Namespace="EntitySpaces.2026.StoredProcedures" 
    Author="EntitySpaces, LLC"
    Version="2026.10.0.0"
    RequiresUI="True" %><%
ArrayList entities = esMeta.Input["Entities"] as ArrayList;
string entityType = (string)esMeta.Input["EntityType"];
string databaseName = (string)esMeta.Input["Database"];
string capturedOutputPath = (string)esMeta.Input["OutputPath"];

ITable table = null;
IView  view = null;
IColumns cols = null;
string allSQL = "";

IDatabase database = esMeta.Databases[databaseName];

foreach(string tableOrView in entities)
{
	if(entityType == dbEntityType.Tables.ToString())
	{
		table = database.Tables[tableOrView];
		view = null;
		cols = table.Columns;
	}
	else 
	{
		view = database.Views[tableOrView];
		table = null;
		cols = view.Columns;
	}
	
	EntitySpaces.MetadataEngine.esPluginSource source = new EntitySpaces.MetadataEngine.esPluginSource(esMeta, table, view);
	esMeta.Input["Source"] = source;
	
	if(table.PrimaryKeys.Count == 0)
	{
		this.ClearOutput();
		continue;
	} 	

//----------------------------------------------------------------------
// LoadByPrimaryKey 
//----------------------------------------------------------------------
%>
<%= BuildDropFunctionStatement(esMeta.esPlugIn.ProcLoadByPK(table.Name), BuildArgTypesForPK(table)) %>
CREATE FUNCTION "<%=esMeta.esPlugIn.ProcLoadByPK(table.Name)%>"
(<%
	bool inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=", "%><%}%>		
	 IN p_<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
RETURNS SETOF "<%=table.Name%>" AS $es$
	SELECT * FROM "<%=table.Name%>"
	WHERE
	<%
	inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=" AND "%><%}%>
		 "<%=col.Name%>" = p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
%>;
$es$ LANGUAGE sql STABLE;

<%
//----------------------------------------------------------------------
// LoadAll 
//----------------------------------------------------------------------
%>
<%= BuildDropFunctionStatement(esMeta.esPlugIn.ProcLoadAll(table.Name), "") %>
CREATE FUNCTION "<%=esMeta.esPlugIn.ProcLoadAll(table.Name)%>"()
RETURNS SETOF "<%=table.Name%>" AS $es$
	SELECT * FROM "<%=table.Name%>";
$es$ LANGUAGE sql STABLE;

<%
//----------------------------------------------------------------------
// Update
//----------------------------------------------------------------------
int colCount = 0;
foreach(IColumn col in table.Columns)
{
	if(col.IsInPrimaryKey || col.IsComputed)
	{
		colCount++;
	}
}

if(table.Columns.Count == colCount)
{%>
	-------------------------------------------
	-- NO UPDATE Stored Procedure Generated    
	-- All Columns are part of the Primary key 
	-------------------------------------------
<%		
}
else
{
%>
<%= BuildDropFunctionStatement(esMeta.esPlugIn.ProcUpdate(table.Name), BuildArgTypesForUpdate(table)) %>
CREATE FUNCTION "<%=esMeta.esPlugIn.ProcUpdate(table.Name)%>"
(<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsComputed) continue;
		if(IsSpecialColumn(table.Columns, col)) continue;    // [V3-FIX] exclude special from signature

		if(!inFirst) {%><%=", "%><%}%>
	 IN p_<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
RETURNS SETOF "<%=table.Name%>" AS $es$
DECLARE
	v_rowcount integer;
BEGIN
	UPDATE "<%=table.Name%>"
	SET
	<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsComputed || col.IsInPrimaryKey) continue;
		if(IsSpecialColumn(table.Columns, col)) continue;    // [V3-FIX] exclude special from SET

		if(!inFirst) {%><%=", "%><%}%><%
		if(IsEsConcurrency(col)) { %>
		"<%=col.Name%>" = p_<%=StripGarbage(col)%> + 1<%     // [V3-FIX] increment concurrency
		} else { %>
		"<%=col.Name%>" = p_<%=StripGarbage(col)%><%
		}
		inFirst = false;
	}
	%>
	WHERE
	<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(!col.IsInPrimaryKey) continue;
		if(!inFirst) {%><%=" AND "%><%}%>
		"<%=col.Name%>" = p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
	foreach(IColumn col in table.Columns)
	{
		if(!IsEsConcurrency(col)) continue;
		%> AND "<%=col.Name%>" = p_<%=StripGarbage(col)%><%
	}
	%>;

	GET DIAGNOSTICS v_rowcount = ROW_COUNT;
	IF v_rowcount = 0 THEN
		RETURN;
	END IF;

	RETURN QUERY SELECT * FROM "<%=table.Name%>"
	WHERE
	<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(!col.IsInPrimaryKey) continue;
		if(!inFirst) {%><%=" AND "%><%}%>
		"<%=col.Name%>" = p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
	%>;
END;
$es$ LANGUAGE plpgsql VOLATILE;

<%}%>
<%
//----------------------------------------------------------------------
// Insert
//----------------------------------------------------------------------
%>
<%= BuildDropFunctionStatement(esMeta.esPlugIn.ProcInsert(table.Name), BuildArgTypesForInsert(table)) %>
CREATE FUNCTION "<%=esMeta.esPlugIn.ProcInsert(table.Name)%>"
(<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsAutoKey || col.IsComputed) continue;
		if(IsSpecialColumn(table.Columns, col)) continue;
		if(!inFirst) {%><%=", "%><%}%>
	 IN p_<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
RETURNS SETOF "<%=table.Name%>" AS $es$
DECLARE
	v_<%=StripGarbage(FindAutoKey(table))%> <%=FindAutoKey(table).DataTypeNameComplete%>;
BEGIN
	INSERT INTO "<%=table.Name%>"
	(
<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsAutoKey || col.IsComputed) continue;
		if(IsSpecialColumn(table.Columns, col)) continue;
		if(!inFirst) {%><%=", "%><%}%>
		"<%=col.Name%>"<%
		inFirst = false;
	}
%>
	)
	VALUES
	(
<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsAutoKey || col.IsComputed) continue;
		if(IsSpecialColumn(table.Columns, col)) continue;
		if(!inFirst) {%><%=", "%><%}%>
		p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
%>
	)
<%
	IColumn autoKey = FindAutoKey(table);
	if(autoKey != null)
	{
	%>
	RETURNING "<%=autoKey.Name%>" INTO v_<%=StripGarbage(autoKey)%>;
	<%
	}
	else
	{
	%>
	;
	<%
	}
	%>

	RETURN QUERY SELECT * FROM "<%=table.Name%>"
	WHERE
	<%
	inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=" AND "%><%}%>
		"<%=col.Name%>" = v_<%=StripGarbage(col)%><%
		inFirst = false;
	}
	%>;
END;
$es$ LANGUAGE plpgsql VOLATILE;

<%
//----------------------------------------------------------------------
// Delete — [V3-FIX] PK only.
//----------------------------------------------------------------------
%>
<%= BuildDropFunctionStatement(esMeta.esPlugIn.ProcDelete(table.Name), BuildArgTypesForDelete(table)) %>
CREATE FUNCTION "<%=esMeta.esPlugIn.ProcDelete(table.Name)%>"
(<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(!col.IsInPrimaryKey) continue;
		if(!inFirst) {%><%=", "%><%}%>
	 IN p_<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
RETURNS void AS $es$
DECLARE
	v_rowcount integer;
BEGIN
	DELETE FROM "<%=table.Name%>"
	WHERE
<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(!col.IsInPrimaryKey) continue;
		if(!inFirst) {%><%=" AND "%><%}%>
		 "<%=col.Name%>" = p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
%>;

	GET DIAGNOSTICS v_rowcount = ROW_COUNT;
	IF v_rowcount = 0 THEN
		RAISE EXCEPTION 'row not found';
	END IF;
END;
$es$ LANGUAGE plpgsql VOLATILE;

<%
	string sql = output.ToString();
	allSQL += sql;
	SaveToFileAt(capturedOutputPath, table.Name + ".sql", sql);
	this.ClearOutput();	
}

try { SaveToFileAt(capturedOutputPath, "PostgreSQL_ALL.sql", allSQL); }
catch { }
%>

<script runat="template">

private string SaveToFileAt(string outputPath, string fileName, string text)
{
	string path = outputPath;
	if (string.IsNullOrEmpty(path)) path = ".";
	if (!path.EndsWith("\\") && !path.EndsWith("/")) path += "\\";
	Directory.CreateDirectory(path);
	using (StreamWriter sw = System.IO.File.CreateText(path + fileName)) sw.Write(text);
	return "";
}

private string BuildDropFunctionStatement(string procName, string argTypesCsv)
{
	return "DROP FUNCTION IF EXISTS \"" + procName + "\"(" + argTypesCsv + ");";
}

private string StripGarbage(IColumn col)
{
	return esMeta.esPlugIn.ToPascalCase(col.Alias);
}

private IColumn FindAutoKey(ITable table)
{
	foreach(IColumn col in table.Columns)
	{
		if(col.IsAutoKey) return col;
	}
	return null;
}

private bool IsSpecialColumn(IColumns cols, IColumn col)
{
	if (col == null || string.IsNullOrEmpty(col.Name)) return false;
	string n = col.Name;
	if (string.Equals(n, "DateAdded",    StringComparison.OrdinalIgnoreCase)) return true;
	if (string.Equals(n, "DateModified", StringComparison.OrdinalIgnoreCase)) return true;
	if (string.Equals(n, "AddedBy",      StringComparison.OrdinalIgnoreCase)) return true;
	if (string.Equals(n, "ModifiedBy",   StringComparison.OrdinalIgnoreCase)) return true;
	return false;
}

private bool IsEsConcurrency(IColumn col)
{
	if (col == null || string.IsNullOrEmpty(col.Name)) return false;
	try { if (col.IsEntitySpacesConcurrency) return true; } catch { }
	if (string.Equals(col.Name, "Version",       StringComparison.OrdinalIgnoreCase)) return true;
	if (string.Equals(col.Name, "RowVersion",    StringComparison.OrdinalIgnoreCase)) return true;
	if (string.Equals(col.Name, "VersionNumber", StringComparison.OrdinalIgnoreCase)) return true;
	return false;
}

private string BuildArgTypesForInsert(ITable table)
{
	string args = ""; bool first = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsAutoKey || col.IsComputed) continue;
		if(IsSpecialColumn(table.Columns, col)) continue;
		if(!first) args += ", ";
		args += col.DataTypeNameComplete;
		first = false;
	}
	return args;
}

private string BuildArgTypesForUpdate(ITable table)
{
	string args = ""; bool first = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsComputed) continue;
		if(IsSpecialColumn(table.Columns, col)) continue;
		if(!first) args += ", ";
		args += col.DataTypeNameComplete;
		first = false;
	}
	return args;
}

private string BuildArgTypesForDelete(ITable table)
{
	string args = ""; bool first = true;
	foreach(IColumn col in table.Columns)
	{
		if(!col.IsInPrimaryKey) continue;
		if(!first) args += ", ";
		args += col.DataTypeNameComplete;
		first = false;
	}
	return args;
}

private string BuildArgTypesForPK(ITable table)
{
	string args = ""; bool first = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!first) args += ", ";
		args += col.DataTypeNameComplete;
		first = false;
	}
	return args;
}

</script>
