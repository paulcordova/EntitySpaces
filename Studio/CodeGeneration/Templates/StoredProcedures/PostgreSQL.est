=========================================================================

    POSTGRESQL STORED PROCEDURE TEMPLATE

    Revision 2026.11:
    -----------------
    Fix A: DROP FUNCTION IF EXISTS before every CREATE FUNCTION.
    Fix B: LANGUAGE plpgsql for INSERT / UPDATE / DELETE.
    Fix C: INSERT / UPDATE return SETOF "<table>" via RETURN QUERY.
    Fix D: Exclude auto-generated columns from INSERT.
    Fix E: Dollar-quote tag $es$ instead of $$.
    Fix F: DELETE includes concurrency column when present.

    Fix G (2026.11.1):
           - Capture OutputPath at template start into a local field so
             the consolidated PostgreSQL_ALL.sql write at the end does not
             depend on esMeta.Input still being valid after the main loop.
           - Wrap the final SaveToFile in try/catch with diagnostic log
             to a sibling file (_es_template_log.txt) so failures are
             visible.
*/%>
<%@ TemplateInfo 
    UniqueID="26AF598A-4CF9-4b24-BB01-A71565959C0E"
	UserInterfaceID="D08B0E66-E1C9-446a-A40E-1DDA5DE00777"
    Title="PostgreSQL"   
    Description="PostgreSQL Stored Procedures" 
    Namespace="EntitySpaces.2026.StoredProcedures" 
    Author="EntitySpaces, LLC"
    Version="2026.11.1.0"
    RequiresUI="True" %><%
//-------------------------------------------------------
// Extract the UI choices that we need
//-------------------------------------------------------
ArrayList entities = esMeta.Input["Entities"] as ArrayList;
string entityType = (string)esMeta.Input["EntityType"];
string databaseName = (string)esMeta.Input["Database"];

//-------------------------------------------------------
// [FIX-G] Capture OutputPath ONCE, at template start, and reuse it.
// The metadata input may not survive the full iteration; capturing
// here guarantees the consolidated write at the end has a valid path.
//-------------------------------------------------------
string capturedOutputPath = (string)esMeta.Input["OutputPath"];

//-------------------------------------------------------
// Create Local Variables
//-------------------------------------------------------	
int lastOrdinal = 0;

ITable table = null;
IView  view = null;
IColumns cols = null;

string allSQL = "";

IDatabase database = esMeta.Databases[databaseName];

foreach(string tableOrView in entities)
{
	string text = "";
	
	if(entityType == dbEntityType.Tables.ToString())
	{
		table = database.Tables[tableOrView];
		view = null;
		cols = table.Columns;
	}
	else 
	{
		view = database.Views[tableOrView];
		
		table = null;
		cols = view.Columns;
	}
	
	EntitySpaces.MetadataEngine.esPluginSource source = new EntitySpaces.MetadataEngine.esPluginSource(esMeta, table, view);
	esMeta.Input["Source"] = source;
	
	if(table.PrimaryKeys.Count == 0)
	{
		this.ClearOutput();
		continue;
	} 	

//----------------------------------------------------------------------
// LoadByPrimaryKey 
//----------------------------------------------------------------------
%>
<%= BuildDropFunctionStatement(esMeta.esPlugIn.ProcLoadByPK(table.Name), BuildArgTypesForPK(table)) %>
CREATE FUNCTION "<%=esMeta.esPlugIn.ProcLoadByPK(table.Name)%>"
(<%
	bool inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=", "%><%}%>		
	 IN p_<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
RETURNS SETOF "<%=table.Name%>" AS $es$
	SELECT * FROM "<%=table.Name%>"
	WHERE
	<%
	inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=" AND "%><%}%>
		 "<%=col.Name%>" = p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
%>;
$es$ LANGUAGE sql STABLE;

<%
//----------------------------------------------------------------------
// LoadAll 
//----------------------------------------------------------------------
%>
<%= BuildDropFunctionStatement(esMeta.esPlugIn.ProcLoadAll(table.Name), "") %>
CREATE FUNCTION "<%=esMeta.esPlugIn.ProcLoadAll(table.Name)%>"()
RETURNS SETOF "<%=table.Name%>" AS $es$
	SELECT * FROM "<%=table.Name%>";
$es$ LANGUAGE sql STABLE;

<%
//----------------------------------------------------------------------
// Update
//----------------------------------------------------------------------
int colCount = 0;

foreach(IColumn col in table.Columns)
{
	if(col.IsInPrimaryKey || col.IsComputed)
	{
		colCount++;
	}
}

if(table.Columns.Count == colCount)
{%>

	-------------------------------------------
	-- NO UPDATE Stored Procedure Generated    
	-- All Columns are part of the Primary key 
	-------------------------------------------
	
<%		
}
else
{
%>
<%= BuildDropFunctionStatement(esMeta.esPlugIn.ProcUpdate(table.Name), BuildArgTypesForUpdate(table)) %>
CREATE FUNCTION "<%=esMeta.esPlugIn.ProcUpdate(table.Name)%>"
(<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsComputed) continue;

		if(!inFirst) {%><%=", "%><%}%>
	 IN p_<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
RETURNS SETOF "<%=table.Name%>" AS $es$
BEGIN
	UPDATE "<%=table.Name%>"
	SET
	<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsComputed || col.IsInPrimaryKey) continue;

		if(!inFirst) {%><%=", "%><%}%>
		"<%=col.Name%>" = p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
	%>
	WHERE
	<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(!col.IsInPrimaryKey) continue;

		if(!inFirst) {%><%=" AND "%><%}%>
		"<%=col.Name%>" = p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
	%>;

	RETURN QUERY SELECT * FROM "<%=table.Name%>"
	WHERE
	<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(!col.IsInPrimaryKey) continue;

		if(!inFirst) {%><%=" AND "%><%}%>
		"<%=col.Name%>" = p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
	%>;
END;
$es$ LANGUAGE plpgsql VOLATILE;

<%}%>
<%
//----------------------------------------------------------------------
// Insert
//----------------------------------------------------------------------
%>
<%= BuildDropFunctionStatement(esMeta.esPlugIn.ProcInsert(table.Name), BuildArgTypesForInsert(table)) %>
CREATE FUNCTION "<%=esMeta.esPlugIn.ProcInsert(table.Name)%>"
(<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsAutoKey || col.IsComputed) continue;

		if(!inFirst) {%><%=", "%><%}%>
	 IN p_<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
RETURNS SETOF "<%=table.Name%>" AS $es$
DECLARE
	v_<%=StripGarbage(FindAutoKey(table))%> <%=FindAutoKey(table).DataTypeNameComplete%>;
BEGIN
	INSERT INTO "<%=table.Name%>"
	(
<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsAutoKey || col.IsComputed) continue;

		if(!inFirst) {%><%=", "%><%}%>
		"<%=col.Name%>"<%
		inFirst = false;
	}
%>
	)
	VALUES
	(
<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsAutoKey || col.IsComputed) continue;

		if(!inFirst) {%><%=", "%><%}%>
		p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
%>
	)
<%
	IColumn autoKey = FindAutoKey(table);
	if(autoKey != null)
	{
	%>
	RETURNING "<%=autoKey.Name%>" INTO v_<%=StripGarbage(autoKey)%>;
	<%
	}
	else
	{
	%>
	;
	<%
	}
	%>

	RETURN QUERY SELECT * FROM "<%=table.Name%>"
	WHERE
	<%
	inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=" AND "%><%}%>
		"<%=col.Name%>" = v_<%=StripGarbage(col)%><%
		inFirst = false;
	}
	%>;
END;
$es$ LANGUAGE plpgsql VOLATILE;

<%
//----------------------------------------------------------------------
// Delete
//----------------------------------------------------------------------
%>
<%= BuildDropFunctionStatement(esMeta.esPlugIn.ProcDelete(table.Name), BuildArgTypesForDelete(table)) %>
CREATE FUNCTION "<%=esMeta.esPlugIn.ProcDelete(table.Name)%>"
(<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(!col.IsInPrimaryKey && !col.IsEntitySpacesConcurrency) continue;

		if(!inFirst) {%><%=", "%><%}%>
	 IN p_<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
RETURNS void AS $es$
BEGIN
	DELETE FROM "<%=table.Name%>"
	WHERE
<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(!col.IsInPrimaryKey && !col.IsEntitySpacesConcurrency) continue;

		if(!inFirst) {%><%=" AND "%><%}%>
		 "<%=col.Name%>" = p_<%=StripGarbage(col)%><%
		inFirst = false;
	}
%>;
END;
$es$ LANGUAGE plpgsql VOLATILE;

<%
	// [FIX-G] Capture per-table SQL and accumulate. SaveToFile uses the
	// captured path so it does not depend on esMeta.Input at this point.
	string sql = output.ToString();
	allSQL += sql;
	
	SaveToFileAt(capturedOutputPath, table.Name + ".sql", sql);
	this.ClearOutput();	
} // end main for loop

// [FIX-G] Write the consolidated file AFTER the loop, using the path
// captured at template start. Wrapped in try/catch with a diagnostic
// log so failures do not pass silently.
try
{
	SaveToFileAt(capturedOutputPath, "PostgreSQL_ALL.sql", allSQL);
}
catch (Exception ex)
{
	try
	{
		string logPath = System.IO.Path.Combine(
			string.IsNullOrEmpty(capturedOutputPath) ? "." : capturedOutputPath,
			"_es_template_log.txt");
		System.IO.File.AppendAllText(logPath,
			DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") +
			"  SaveToFile(PostgreSQL_ALL.sql) failed: " + ex.ToString() +
			System.Environment.NewLine);
	}
	catch { /* best-effort */ }
}
%>

<script runat="template">

// [FIX-G] Path-safe writer. Takes the output directory explicitly so it
// is not read from esMeta.Input at call time. Uses the same directory
// discipline as the original SaveToFile.
private string SaveToFileAt(string outputPath, string fileName, string text)
{
	string path = outputPath;
	if (string.IsNullOrEmpty(path))
		path = ".";

	if (!path.EndsWith("\\") && !path.EndsWith("/"))
		path += "\\";

	Directory.CreateDirectory(path);

	string fname = path + fileName;

	using (StreamWriter sw = System.IO.File.CreateText(fname))
	{
		sw.Write(text);
	}

	return "";
}

private string BuildDropFunctionStatement(string procName, string argTypesCsv)
{
	return "DROP FUNCTION IF EXISTS \"" + procName + "\"(" + argTypesCsv + ");";
}

private string StripGarbage(IColumn col)
{
	return esMeta.esPlugIn.ToPascalCase(col.Alias);
}

private IColumn FindAutoKey(ITable table)
{
	foreach(IColumn col in table.Columns)
	{
		if(col.IsAutoKey) return col;
	}
	return null;
}

private string BuildArgTypesForInsert(ITable table)
{
	string args = "";
	bool first = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsAutoKey || col.IsComputed) continue;
		if(!first) args += ", ";
		args += col.DataTypeNameComplete;
		first = false;
	}
	return args;
}

private string BuildArgTypesForUpdate(ITable table)
{
	string args = "";
	bool first = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsComputed) continue;
		if(!first) args += ", ";
		args += col.DataTypeNameComplete;
		first = false;
	}
	return args;
}

private string BuildArgTypesForDelete(ITable table)
{
	string args = "";
	bool first = true;
	foreach(IColumn col in table.Columns)
	{
		if(!col.IsInPrimaryKey && !col.IsEntitySpacesConcurrency) continue;
		if(!first) args += ", ";
		args += col.DataTypeNameComplete;
		first = false;
	}
	return args;
}

private string BuildArgTypesForPK(ITable table)
{
	string args = "";
	bool first = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!first) args += ", ";
		args += col.DataTypeNameComplete;
		first = false;
	}
	return args;
}

</script>