    ORACLE STORED PROCEDURE TEMPLATE

    Revision 2026.10:
    -----------------
    Fix A: Do not emit an empty schema prefix (""."proc_X"). Emitting a
           zero-length quoted identifier raises ORA-01741. When
           table.Schema is empty, the schema prefix is now omitted and
           Oracle resolves the procedure against the current user's
           default schema.
    
    Fix B: Distinguish SEQUENCE-backed auto keys from IDENTITY columns.
           Oracle 12c+ GENERATED BY DEFAULT AS IDENTITY does not use a
           sequence, so emitting SELECT <seq>.NextVal raises ORA-02289.
           Only emit the sequence lookup when col.AutoKeyText is
           non-empty.
    
    Fix C: Exclude IDENTITY columns from the INSERT column list. Oracle
           assigns the value automatically; including the column with a
           NULL placeholder raises ORA-01400.
    
    Fix D: Emit RETURNING ... INTO for IDENTITY columns so the
           generated value reaches the OUT parameter declared for it.
           This is required by the provider, which reads the value back
           through the parameter and writes it into the entity's
           CurrentValues.

    Fix E: Use the PascalCase parameter name in the concurrency preamble
           (pConcurrency := p<Prop>) rather than col.Name, which could
           diverge from the declared parameter name.
*/%>
<%@ TemplateInfo 
    UniqueID="D70AB57A-E524-4103-9F88-CB2D612405E8"
	UserInterfaceID="BCB3B598-9264-40dc-B497-1D872D9E324E"
    Title="Oracle"   
    Description="Oracle Stored Procedures" 
    Namespace="EntitySpaces.2026.StoredProcedures" 
    Author="EntitySpaces, LLC"
    Version="2026.7.0.0"
    RequiresUI="True" %><%
//-------------------------------------------------------
// Extract the UI choices that we need
//-------------------------------------------------------
ArrayList entities = esMeta.Input["Entities"] as ArrayList;
string entityType = (string)esMeta.Input["EntityType"];
string databaseName = (string)esMeta.Input["Database"];

//-------------------------------------------------------
// Create Local Variables
//-------------------------------------------------------	
bool packageDeclared = false;
bool bHasConcurrency = false;
string concurrencyColumn = "";
string dir = "";

string allSQL = "";

//-------------------------------------------------------
// Begin Execution
//-------------------------------------------------------	
ITable table = null;
IColumns cols = null;

IDatabase database = esMeta.Databases[databaseName];

foreach(string tableOrView in entities)
{
	bHasConcurrency = false;
	concurrencyColumn = "";
	
	if(entityType == dbEntityType.Tables.ToString())
	{
		table = database.Tables[tableOrView];
		cols = table.Columns;
	}
	else 
	{
		break;
	}
	
	esPluginSource source = new esPluginSource(esMeta, table, null);
	esMeta.Input["Source"] = source;

	if(table.PrimaryKeys.Count == 0)
	{
		this.ClearOutput();
		continue;
	} 	
	
	if(!packageDeclared)
	{%>
-- Create the Package if it hasn't been already
DECLARE n VARCHAR(256);
BEGIN
SELECT OBJECT_NAME INTO n FROM SYS.ALL_OBJECTS WHERE OBJECT_NAME = 'ENTITYSPACES' AND OWNER = '<%=database.Name%>';
EXCEPTION
WHEN NO_DATA_FOUND THEN
EXECUTE IMMEDIATE 'CREATE PACKAGE <%=database.Name%>.ENTITYSPACES IS TYPE sqlcur IS REF CURSOR; END ENTITYSPACES;';
END;
/

<%		packageDeclared = true;
	}
	
//----------------------------------------------------------------------
// LoadByPrimaryKey 
//----------------------------------------------------------------------
%>
CREATE OR REPLACE PROCEDURE <%=SchemaPrefix(table)%>"<%=esMeta.esPlugIn.ProcLoadByPK(table.Name)%>"
(<%
	// List all keys as parameters
	bool inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=", "%><%}%>
	p<%=StripGarbage(col) + " IN \"" + table.Name + "\".\"" + col.Name + "\"%type"%><%
		inFirst = false;
	}
%>,
	outCursor OUT "<%=database.Name%>".ENTITYSPACES.sqlcur
)
IS
BEGIN
    OPEN outCursor FOR
	SELECT<%
	// List all fields
	inFirst = true;
	foreach(IColumn col in cols)
	{
		if(!inFirst) {%><%=", "%><%}%>
		"<%=col.Name%>"<%
		inFirst = false;
	}
%>
	FROM "<%=table.Name%>"
	WHERE<%
	// Compare keys with parameters
	inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=" AND "%><%}%>
		"<%=col.Name%>" = p<%=StripGarbage(col)%><%
		inFirst = false;
	}
%>;
END;
/

<%
//----------------------------------------------------------------------
// LoadAll 
//----------------------------------------------------------------------
%>
CREATE OR REPLACE PROCEDURE <%=SchemaPrefix(table)%>"<%=esMeta.esPlugIn.ProcLoadAll(table.Name)%>"
(
    outCursor OUT "<%=database.Name%>".ENTITYSPACES.sqlcur
)
IS
BEGIN
    OPEN outCursor FOR
	SELECT<%
	// List all fields
	inFirst = true;
	foreach(IColumn col in cols)
	{
		if(!inFirst) {%><%=", "%><%}%>
		"<%=col.Name%>"<%
		inFirst = false;
	}
%>
	FROM "<%=table.Name%>";

END;
/

<% 
//----------------------------------------------------------------------
// Update
//----------------------------------------------------------------------
// This is a sample of the UPDATE stored proc when concurrency is involved
//----------------------------------------------------------------------
//
//	CREATE PROCEDURE "MYGENERATION"."proc_SeqTestUpdate" ( 
//		pID IN "SeqTest"."ID"%type, 
//		pTimeStamp IN OUT "SeqTest"."TimeStamp"%type, 
//		pData IN "SeqTest"."Data"%type 
//	) 
//	IS 
//		pConcurrency "SeqTest"."TimeStamp"%type := pTimeStamp;      
//	
//	BEGIN 
//		UPDATE "SeqTest" 
//		SET 
//			"TimeStamp" = "TimeStamp" + 1, 
//			"Data"  = pData 
//		WHERE 
//			"ID" = pID 
//		AND "TimeStamp" = pConcurrency 
//	; 
//	
//		IF SQL%ROWCOUNT = 1 THEN 
//		 pTimeStamp := (pConcurrency + 1); 
//		ELSE 
//		 Raise_application_error(01403, //NO RECORDS WERE UPDATED//); 
//		};  
//		 
//	END ;


//----------------------------------------------------------------------
// Update
//----------------------------------------------------------------------
int colCount = 0;

foreach(IColumn col in cols)
{
	if(col.IsInPrimaryKey || col.IsComputed)
	{
		colCount += 1;
	}
}

if (cols.Count == colCount)
{%>

-- -----------------------------------------
-- NO UPDATE Stored Procedure Generated 
-- All Columns are part of the Primary key
-- -----------------------------------------

<%}else{%>
CREATE OR REPLACE PROCEDURE <%=SchemaPrefix(table)%>"<%=esMeta.esPlugIn.ProcUpdate(table.Name)%>"
(<%
	// List all keys as parameters
	inFirst = true;
	foreach(IColumn col in cols)
	{
		// Fix F: special columns are not part of the UPDATE signature.
		// DateAdded and AddedBy never change; DateModified and ModifiedBy
		// are handled server-side in the SET clause below.
		if(IsSpecialColumn(col)) continue;
	
		if(!inFirst) {%><%=", "%><%}%><%
		inFirst = false;
		
		dir = " IN ";
		if(col.IsEntitySpacesConcurrency)
		{
			dir = " IN OUT ";
			bHasConcurrency = true;
			concurrencyColumn = col.Name;
		}		
		%>
	p<%=StripGarbage(col) + dir + "\"" + table.Name + "\".\"" + col.Name + "\"%type"%><%		
		
		if((col.IsNullable || col.IsComputed) && dir == " IN ")
		{
			// " default  NULL"
		}
	}
%>
)
IS<%if(bHasConcurrency) { %>
	pConcurrency "<%=table.Name%>"."<%=concurrencyColumn%>"%type := p<%=StripGarbage(FindColumnByName(cols, concurrencyColumn))%>; 	
<%}%>
BEGIN
	UPDATE "<%=table.Name%>"
	SET<%
	// List all fields
	inFirst = true;
	foreach(IColumn col in cols)
	{
		// Skip auto, computed, and special columns. Special columns are
		// emitted explicitly below so DateModified gets SYSTIMESTAMP.
		if(!col.IsAutoKey && !col.IsComputed && !IsSpecialColumn(col))
		{
			if(!inFirst) {%><%=", "%><%}%><%
			inFirst = false;
			
			if(col.IsEntitySpacesConcurrency)
			{%>
		"<%=col.Name%>" = "<%=col.Name%>" + 1<%			
			}
			else
			{%>
		"<%=col.Name%>" = p<%=StripGarbage(col)%><%				
			}
		}
	}
	// Fix F: DateModified is refreshed server-side on every UPDATE.
	// ModifiedBy is left as-is: the client never populates it (ServerSide
	// with UseEventHandler = false), so touching it would write NULL.
	if(HasSpecialColumn(cols, "DateModified"))
	{
		if(!inFirst) {%><%=", "%><%}%>
		"DateModified" = SYSTIMESTAMP<%
		inFirst = false;
	}
%>
	WHERE<%
	// Compare keys with parameters
	inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=" AND "%><%}%>
		"<%=col.Name%>" = p<%=StripGarbage(col)%><%
		inFirst = false;
	}
	
	if(bHasConcurrency)
	{%>
    AND "<%=concurrencyColumn%>" = pConcurrency<%
	}	
	%>;<%
	if(bHasConcurrency) { %>
	
	IF SQL%ROWCOUNT = 1 THEN   
	    p<%=StripGarbage(FindColumnByName(cols, concurrencyColumn))%> := (pConcurrency + 1);
	ELSE  
	    Raise_application_error(-20101, 'NO RECORDS WERE UPDATED');  
	END IF;
<%
	}
%>	
	
END;
/
<%}%>

<% 
//----------------------------------------------------------------------
// Insert
//----------------------------------------------------------------------
%>
CREATE OR REPLACE PROCEDURE <%=SchemaPrefix(table)%>"<%=esMeta.esPlugIn.ProcInsert(table.Name)%>"
(<%
	// List all keys as parameters
	inFirst = true;
	foreach(IColumn col in cols)
	{
		if(!inFirst) {%><%=", "%><%}%><%
		
		dir = " IN ";
		if(col.IsAutoKey || col.IsEntitySpacesConcurrency)
		{
			dir = " OUT ";
		}
		// Fix F: special columns are returned to the client via RETURNING,
		// not accepted as IN. The DB fills them (DEFAULT SYSTIMESTAMP).
		if(IsSpecialColumn(col))
		{
			dir = " OUT ";
		}
		%>
	p<%=StripGarbage(col) + dir + "\"" + table.Name + "\".\"" + col.Name + "\"%type"%><%		
		
		inFirst = false;
		
		if((col.IsNullable || col.IsComputed) && dir == " IN ")
		{
			%><%=" default NULL"%><%
		}	
	}
%>
)
IS
BEGIN
<%
	foreach(IColumn col in cols)
	{
		// Fix B: only emit the sequence lookup when there is an actual
		// sequence name. IDENTITY columns have an empty AutoKeyText.
		if(col.IsAutoKey && !string.IsNullOrEmpty(col.AutoKeyText))	
		{%>
	SELECT "<%=col.AutoKeyText%>".NextVal INTO p<%=StripGarbage(col)%> FROM DUAL;<%
		}
		
		if(col.IsEntitySpacesConcurrency)
		{%>
	p<%=StripGarbage(col)%> := 1;<%
		}
	}
%>

	INSERT
	INTO "<%=table.Name%>"
	(<%
		// Fix C: exclude computed columns AND IDENTITY columns from the
		// INSERT column list. Oracle generates IDENTITY values itself.
		inFirst = true;
		foreach(IColumn col in cols)
		{
			bool isIdentity = col.IsAutoKey && string.IsNullOrEmpty(col.AutoKeyText);
			if(!col.IsComputed && !isIdentity && !IsSpecialColumn(col))
			{
				if(!inFirst) {%><%=", "%><%}%>
		"<%=col.Name%>"<%
				inFirst = false;
			}
		}
%>
	)
	VALUES
	(<%
		// Fix C (continued): mirror the exclusion in the VALUES list.
		inFirst = true;
		foreach(IColumn col in cols)
		{
			bool isIdentity = col.IsAutoKey && string.IsNullOrEmpty(col.AutoKeyText);
			if(!col.IsComputed && !isIdentity && !IsSpecialColumn(col))
			{
				if(!inFirst) {%><%=", "%><%}%>
		p<%=StripGarbage(col)%><%
				inFirst = false;
			}
		}
%>	
	)<%
	// Fix F: RETURNING returns identity columns AND special columns
	// (DateAdded, DateModified, AddedBy, ModifiedBy). All of them are
	// populated server-side and must reach the OUT parameters that the
	// provider reads back into CurrentValues.
	bool hasReturning = false;
	foreach(IColumn col in cols)
	{
		bool isIdentity = col.IsAutoKey && string.IsNullOrEmpty(col.AutoKeyText);
		if(isIdentity || IsSpecialColumn(col))
		{
			hasReturning = true;
			break;
		}
	}
	if(hasReturning)
	{
		%>
	RETURNING <%
		inFirst = true;
		foreach(IColumn col in cols)
		{
			bool isIdentity = col.IsAutoKey && string.IsNullOrEmpty(col.AutoKeyText);
			if(isIdentity || IsSpecialColumn(col))
			{
				if(!inFirst) {%><%=", "%><%}%>"<%=col.Name%>"<%
				inFirst = false;
			}
		}
		%> INTO <%
		inFirst = true;
		foreach(IColumn col in cols)
		{
			bool isIdentity = col.IsAutoKey && string.IsNullOrEmpty(col.AutoKeyText);
			if(isIdentity || IsSpecialColumn(col))
			{
				if(!inFirst) {%><%=", "%><%}%>p<%=StripGarbage(col)%><%
				inFirst = false;
			}
		}
	}
	%>;
	END;
/
<% 
//----------------------------------------------------------------------
// Delete
//----------------------------------------------------------------------
%>
CREATE OR REPLACE PROCEDURE <%=SchemaPrefix(table)%>"<%=esMeta.esPlugIn.ProcDelete(table.Name)%>"
(<%
	dir = " IN ";
	// List all keys as parameters
	inFirst = true;
	foreach(IColumn col in cols)
	{
		if((concurrencyColumn == col.Name) || col.IsInPrimaryKey)
		{
			if(!inFirst) {%><%=", "%><%}%>
	p<%=StripGarbage(col) + dir + "\"" + table.Name + "\".\"" + col.Name + "\"%type"%><%				
			inFirst = false;
		}
	}
%>
)
IS
BEGIN

	DELETE FROM "<%=table.Name%>"
	WHERE<%
	// Compare keys with parameters
	inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=" AND "%><%}%>
		"<%=col.Name%>" = p<%=StripGarbage(col)%><%
		inFirst = false;
	}
	
	if(bHasConcurrency)
	{%>
		AND "<%=concurrencyColumn%>" = p<%=StripGarbage(FindColumnByName(cols, concurrencyColumn))%><%
	}		
	
	%>;<%
	
	if(bHasConcurrency) 
	{%>
	
	IF SQL%ROWCOUNT <> 1 THEN   
	    Raise_application_error(-20101, 'NO RECORDS WERE UPDATED');  
	END IF;
<%
	}	
%>

END;
/
<%
	string sql = output.ToString();
	allSQL += sql;
	
	this.SaveToFile(table.Name + ".sql", sql, false);
	this.ClearOutput();	
} // end main for loop

	this.SaveToFile("Oracle_ALL.sql", allSQL, false);
%>

<script runat="template">

private string SaveToFile(string fileName, string text, bool generateSingleFile)
{
	if(!generateSingleFile)
	{
	    string path = (string)esMeta.Input["OutputPath"];
	    
		string fname = path;
		if (!fname.EndsWith("\\")) 
			fname += "\\";
			
		Directory.CreateDirectory(path);		
		
		fname += fileName;
		
		using (StreamWriter sw = System.IO.File.CreateText(fname)) 
		{
			sw.Write(text);
		} 	
		
		return "";
	}
	else
	{
		return text;			
	}
}

private string StripGarbage(IColumn col)
{
	return esMeta.esPlugIn.ToPascalCase(col.Alias);
}

// Fix A: returns `"schema".` when a schema is present, or an empty
// string when it is not. This prevents emitting `""."proc_X"` which
// Oracle rejects with ORA-01741.
private string SchemaPrefix(ITable table)
{
	if (table == null || string.IsNullOrEmpty(table.Schema))
		return string.Empty;
	return "\"" + table.Schema + "\".";
}

// Fix E: locate a column by its physical name so we can reuse the same
// StripGarbage() helper that generated the parameter name.
private IColumn FindColumnByName(IColumns cols, string name)
{
	if (cols == null || string.IsNullOrEmpty(name))
		return null;
	foreach (IColumn col in cols)
	{
		if (col.Name == name)
			return col;
	}
	return null;
}

// Detects the four EntitySpaces special columns by name. The provider
// receives them from the client only as placeholders; the DB fills them
// via DEFAULT or trigger. The SP must not receive them as IN parameters.
private bool IsSpecialColumn(IColumn col)
{
    if (col == null || string.IsNullOrEmpty(col.Name)) return false;
    string n = col.Name.ToLowerInvariant();
    return n == "dateadded" || n == "datemodified" || n == "addedby" || n == "modifiedby";
}

// Checks whether the columns collection contains a special column by name.
// Used in the UPDATE block to know whether to emit `"DateModified" = SYSTIMESTAMP`.
private bool HasSpecialColumn(IColumns cols, string name)
{
    if (cols == null) return false;
    string want = name.ToLowerInvariant();
    foreach (IColumn c in cols)
    {
        if (c != null && !string.IsNullOrEmpty(c.Name) &&
            c.Name.ToLowerInvariant() == want)
            return true;
    }
    return false;
}

</script>
