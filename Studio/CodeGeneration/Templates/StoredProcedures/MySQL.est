    is located here:

    http://www.entityspaces.net/portal/License/tabid/97/Default.aspx
    
=========================================================================

    MySQL / MariaDB STORED PROCEDURE TEMPLATE

    Revision 2026.10:
    -----------------
    Fix A: SP Insert excludes special + concurrency columns from the
           INSERT column list. The DDL DEFAULT fills dateAdded,
           dateModified (CURRENT_TIMESTAMP(6)) and version (1).

    Fix B: SP Insert returns those columns via SELECT ... INTO after
           LAST_INSERT_ID(), so the provider reads them back into
           CurrentValues through the OUT parameters.

    Fix C: SP Update declares pDateAdded / pDateModified / pVersion as
           INOUT and returns them via SELECT ... INTO.

    Fix D: SP Update SET clause refreshes dateModified with
           CURRENT_TIMESTAMP(6) and bumps version server-side.
           dateAdded is skipped — it must never be overwritten.

    Fix E: SP Update / Delete add "AND `version` = pVersion" to the
           WHERE clause for optimistic concurrency. ROW_COUNT() = 0
           raises SIGNAL SQLSTATE '45000', which the provider maps to
           esConcurrencyException via Shared.CheckForConcurrencyException.

    Fix F: SP Delete accepts pVersion as an IN parameter (the provider
           already sends it because IsEntitySpacesConcurrency is set).

    Fix G: No USE statement is emitted. The script is meant to be applied
           against whichever database the deployment target resolves at
           runtime (CLI -D flag, Workbench active schema, migration
           framework, etc.). Including USE would pin the script to a
           development database name.

    Dependency: requires the MySqlColumn.IsEntitySpacesConcurrency
                override in the MetadataEngine.MySql driver. Studio's
                Custom Fields -> Concurrency config is applied to BO
                generation but not always to SP generation, so the base
                flag comes through as false in this template. The driver
                override adds a name-based fallback ("version").
*/
%>
<%@ TemplateInfo 
    UniqueID="8F1DCABB-8B14-428c-8D32-0BF463611BB3"
	UserInterfaceID="977DCCF4-5529-406e-A392-CEB0267AD416"
    Title="MySQL"   
    Description="MySQL Stored Procedures" 
    Namespace="EntitySpaces.2026.StoredProcedures" 
    Author="EntitySpaces, LLC"
    Version="2026.10.0.0"
    RequiresUI="True" %><%
//-------------------------------------------------------
// Extract the UI choices that we need
//-------------------------------------------------------
ArrayList entities         = esMeta.Input["Entities"] as ArrayList;
string entityType          = (string)esMeta.Input["EntityType"];
string databaseName        = (string)esMeta.Input["Database"];
bool useSqlSecurityInvoker = (bool)esMeta.Input["UseSqlSecurityInvoker"];

//-------------------------------------------------------
// Create Local Variables
//-------------------------------------------------------	
bool inFirst = true;
string delimiter = "`";
string allSQL = "";

//-------------------------------------------------------
// Begin Execution
//-------------------------------------------------------
ITable table = null;
IColumns cols = null;

IDatabase database = esMeta.Databases[databaseName];

foreach(string tableOrView in entities)
{
	if(entityType == dbEntityType.Tables.ToString())
	{
		table = database.Tables[tableOrView];
		cols = table.Columns;
	}
	else 
	{
		break;
	}
	
	esPluginSource source = new esPluginSource(esMeta, table, null);
	esMeta.Input["Source"] = source;
	
	if(table.PrimaryKeys.Count == 0)
	{
		this.ClearOutput();
		continue;
	} 	

	bool hasConcurrency = false;
	foreach(IColumn col in cols)
	{
		if(col.IsEntitySpacesConcurrency) { hasConcurrency = true; break; }
	}

//----------------------------------------------------------------------
// LoadByPrimaryKey 
//----------------------------------------------------------------------
%>DELIMITER //

/* LoadByPrimaryKey */
<%=BuildCreateAlterStatement(esMeta.esPlugIn.ProcLoadByPK(table.Name)) %>
(<%
	inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=", "%><%}%>
	p<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
<%
	if(useSqlSecurityInvoker) { %>	SQL SECURITY INVOKER<% }
%>
BEGIN

	SELECT<%
	inFirst = true;
	foreach(IColumn col in cols)
	{
		if(!inFirst) {%><%=", "%><%}%>
		<%=delimiter%><%=col.Name%><%=delimiter%><%
		inFirst = false;
	}
%>
	FROM <%=delimiter%><%=table.Name%><%=delimiter%>
	WHERE
	(<%
	inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=" AND "%><%}%>
		<%=delimiter%><%=col.Name%><%=delimiter%> = p<%=StripGarbage(col)%><%
		inFirst = false;
	}
%>
	);

END//

<%
//----------------------------------------------------------------------
// LoadAll 
//----------------------------------------------------------------------
%>
/* LoadAll */
<%=BuildCreateAlterStatement(esMeta.esPlugIn.ProcLoadAll(table.Name)) %>
()
<%
	if(useSqlSecurityInvoker) { %>	SQL SECURITY INVOKER<% }
%>
BEGIN

	SELECT<%
	inFirst = true;
	foreach(IColumn col in cols)
	{
		if(!inFirst) {%><%=", "%><%}%>
		<%=delimiter%><%=col.Name%><%=delimiter%><%
		inFirst = false;
	}
%>
	FROM <%=delimiter%><%=table.Name%><%=delimiter%>;

END//

<%
//----------------------------------------------------------------------
// Update
//----------------------------------------------------------------------
int colCount = 0;
foreach(IColumn col in cols)
{
	if(col.IsInPrimaryKey || col.IsComputed) colCount += 1;
}

if (cols.Count == colCount)
{%>

-- -----------------------------------------
-- NO UPDATE Stored Procedure Generated 
-- All Columns are part of the Primary key
-- -----------------------------------------

<%}else{%>
/* Update */
<%=BuildCreateAlterStatement(esMeta.esPlugIn.ProcUpdate(table.Name))%>
(<%
	inFirst = true;
	foreach(IColumn col in cols)
	{
		if(!inFirst) {%><%=", "%><%}%>
	<%
		if(col.IsComputed || col.IsEntitySpacesConcurrency) {%>INOUT <%}%>p<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
<%
	if(useSqlSecurityInvoker) { %>	SQL SECURITY INVOKER<% }
%>
BEGIN

	UPDATE <%=delimiter%><%=table.Name %><%=delimiter%>
	SET<%
	inFirst = true;
	foreach(IColumn col in cols)
	{
		if(col.IsInPrimaryKey || col.IsAutoKey || col.IsComputed) continue;
		if(IsImmutableServerColumn(col)) continue;

		if(!inFirst) {%><%=", "%><%}%><%
		if(col.IsEntitySpacesConcurrency) {%>
		<%=delimiter%><%=col.Name%><%=delimiter%> = <%=delimiter%><%=col.Name%><%=delimiter%> + 1<%}
		else if(IsDateModifiedServerColumn(col)) {%>
		<%=delimiter%><%=col.Name%><%=delimiter%> = CURRENT_TIMESTAMP(6)<%}
		else {%>
		<%=delimiter%><%=col.Name%><%=delimiter%> = p<%=StripGarbage(col)%><%}%><%
		inFirst = false;
	}
%>
	WHERE
	(<%
	inFirst = true;
	foreach(IColumn col in table.PrimaryKeys)
	{
		if(!inFirst) {%><%=" AND "%><%}%>
		<%=delimiter%><%=col.Name%><%=delimiter%> = p<%=StripGarbage(col)%><%
		inFirst = false;
	}
	
	foreach(IColumn col in table.Columns)
	{
		if(col.IsEntitySpacesConcurrency)
		{
			if(!inFirst) {%><%=" AND "%><%}%>
		<%=delimiter%><%=col.Name%><%=delimiter%> = p<%=StripGarbage(col)%><%
		}
	}
%>
	);
<%
	if(hasConcurrency)
	{%>

	IF ROW_COUNT() = 0 THEN
		SIGNAL SQLSTATE '45000'
			SET MESSAGE_TEXT = 'esConcurrencyException: stale version on update';
	END IF;
<%
	}
%>
	<%=BuildReadbackSelect(cols, delimiter, table.Name)%>
END//

<%} // END UPDATE%> 

<%
//----------------------------------------------------------------------
// Insert
//----------------------------------------------------------------------
%>
/* Insert */
<%=BuildCreateAlterStatement(esMeta.esPlugIn.ProcInsert(table.Name))%>
(<%
	inFirst = true;
	foreach(IColumn col in cols)
	{
		if(!inFirst) {%><%=", "%><%}%>
	<%
		if(col.IsAutoKey || col.IsComputed || col.IsEntitySpacesConcurrency) {%>OUT <%}%>p<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
		inFirst = false;
	}
%>
)
<%
	if(useSqlSecurityInvoker) { %>	SQL SECURITY INVOKER<% }
%>
BEGIN
	INSERT
	INTO <%=delimiter%><%=table.Name%><%=delimiter%>
	(<%
		inFirst = true;
		foreach(IColumn col in cols)
		{
			if(IsExcludedFromInsert(col)) continue;
			
			if(!inFirst) {%><%=", "%><%}%>
		<%=delimiter%><%=col.Name%><%=delimiter%><%
			inFirst = false;
		}
%>
	)
	VALUES
	(<%
		inFirst = true;
		foreach(IColumn col in cols)
		{
			if(IsExcludedFromInsert(col)) continue;
			
			if(!inFirst) {%><%=", "%><%}%>p<%=StripGarbage(col)%><%
			inFirst = false;
		}
%>
	);
<%
	foreach(IColumn col in cols)
	{
		if(col.IsAutoKey)
		{
			%>
	SET p<%=StripGarbage(col)%> = LAST_INSERT_ID();<%
		}
	}
%>
	<%=BuildReadbackSelect(cols, delimiter, table.Name)%>
END//

<%
//----------------------------------------------------------------------
// Delete
//----------------------------------------------------------------------
%>
/* Delete */
<%=BuildCreateAlterStatement(esMeta.esPlugIn.ProcDelete(table.Name))%>
(<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsInPrimaryKey || col.IsEntitySpacesConcurrency)
		{
			if(!inFirst) {%><%=", "%><%}%>
	p<%=StripGarbage(col)%> <%=col.DataTypeNameComplete%><%
			inFirst = false;
		}
	}
%>
)
<%
	if(useSqlSecurityInvoker) { %>	SQL SECURITY INVOKER<% }
%>
BEGIN
	DELETE
	FROM <%=delimiter%><%=table.Name%><%=delimiter%>
	WHERE
	(<%
	inFirst = true;
	foreach(IColumn col in table.Columns)
	{
		if(col.IsInPrimaryKey || col.IsEntitySpacesConcurrency)
		{
			if(!inFirst) {%><%=" AND "%><%}%>
		<%=delimiter%><%=col.Name%><%=delimiter%> = p<%=StripGarbage(col)%><%
			inFirst = false;
		}
	}
%>
	);
<%
	if(hasConcurrency)
	{%>

	IF ROW_COUNT() = 0 THEN
		SIGNAL SQLSTATE '45000'
			SET MESSAGE_TEXT = 'esConcurrencyException: stale version on delete';
	END IF;
<%
	}
%>
END//

DELIMITER ;

<%
	string sql = output.ToString();
	allSQL += sql;
	
	this.SaveToFile(table.Name + ".sql", sql, false);
	this.ClearOutput();	
} // end main for loop

	this.SaveToFile("MySQL_ALL.sql", allSQL, false);
%>

<script runat="template">

private string SaveToFile(string fileName, string text, bool generateSingleFile)
{
	if(!generateSingleFile)
	{
		string path = (string)esMeta.Input["OutputPath"];
		
		string fname = path;
		if (!fname.EndsWith("\\")) 
			fname += "\\";
			
		Directory.CreateDirectory(path);		
		
		fname += fileName;
		
		using (StreamWriter sw = System.IO.File.CreateText(fname)) 
		{
			sw.Write(text);
		} 	
		
		return "";
	}
	else
	{
		return text;			
	}
}

private string BuildCreateAlterStatement(string procName)
{
	string d = "`";
	
	string sql = "";
	
	sql += "DROP PROCEDURE IF EXISTS ";
	sql += d + procName + d + "//" + "\r\n\r\n";

	sql += "CREATE PROCEDURE " + d + procName + d;

	return sql; 
}

private string StripGarbage(EntitySpaces.MetadataEngine.IColumn col)
{
	return esMeta.esPlugIn.ToPascalCase(col.Alias);
}

// Columns excluded from INSERT: auto-increment, computed (dateAdded,
// dateModified in MySQL), and concurrency (version). The DDL DEFAULT
// fills them; the SP reads them back via SELECT INTO.
private bool IsExcludedFromInsert(IColumn col)
{
	if(col == null) return false;
	return col.IsAutoKey || col.IsComputed || col.IsEntitySpacesConcurrency;
}

// dateAdded is immutable on UPDATE. Never emit it in SET.
private bool IsImmutableServerColumn(IColumn col)
{
	if(col == null || string.IsNullOrEmpty(col.Name)) return false;
	return col.Name.ToLowerInvariant() == "dateadded";
}

// dateModified refreshes server-side on UPDATE with CURRENT_TIMESTAMP(6).
private bool IsDateModifiedServerColumn(IColumn col)
{
	if(col == null || string.IsNullOrEmpty(col.Name)) return false;
	return col.Name.ToLowerInvariant() == "datemodified";
}

// Builds the "SELECT ... INTO pX, pY ... WHERE pk = pPk;" read-back used by
// both the INSERT and the UPDATE stored procedures. Returns an empty string
// if there are no computed or concurrency columns to read back.
private string BuildReadbackSelect(IColumns cols, string d, string tableName)
{
	string colsList = "";
	string intoList = "";
	string whereClause = "";
	string comma = "";
	string and = "";

	foreach(IColumn col in cols)
	{
		if(col.IsInPrimaryKey)
		{
			whereClause += and + d + col.Name + d + " = p" + StripGarbage(col);
			and = " AND ";
		}

		if(col.IsComputed || col.IsEntitySpacesConcurrency)
		{
			colsList += comma + d + col.Name + d;
			intoList += comma + "p" + StripGarbage(col);
			comma = ", ";
		}
	}

	if(colsList.Length == 0) return "";

	return "SELECT " + colsList + "\r\n"
	     + "  INTO " + intoList + "\r\n"
	     + "  FROM " + d + tableName + d + "\r\n"
	     + " WHERE (" + whereClause + ");\r\n";
}

</script>