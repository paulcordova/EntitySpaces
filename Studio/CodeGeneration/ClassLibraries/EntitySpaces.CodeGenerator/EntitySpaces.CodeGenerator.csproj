<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<RootNamespace>EntitySpaces.CodeGenerator</RootNamespace>
		<AssemblyName>EntitySpaces.CodeGenerator</AssemblyName>
		<!--<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\..\StrongNameKey\EntitySpaces.snk</AssemblyOriginatorKeyFile>-->

		<!-- Desactivado para evitar conflictos con Properties\AssemblyInfo.cs y SharedVersion.cs -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<PlatformTarget>x86</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\EntitySpaces.MetadataEngine\EntitySpaces.MetadataEngine.csproj" />
	</ItemGroup>

	<!-- ✅ ROSLYN - Reemplazo moderno de CodeDom para compilación en runtime en .NET 8 -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" />
		
	</ItemGroup>

	<ItemGroup>
		<!-- Mantenemos los archivos vinculados (links) que están fuera del directorio actual -->
		<Compile Include="..\..\SharedFiles\SharedVersion.cs" Link="SharedVersion.cs" />
		<None Include="..\..\StrongNameKey\EntitySpaces.snk" Link="EntitySpaces.snk" />
	</ItemGroup>

</Project>