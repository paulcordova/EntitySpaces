<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Library</OutputType>
	<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
	<TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
	<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Habilitamos explícitamente el soporte para WinForms -->
    <UseWindowsForms>true</UseWindowsForms>
    
    <RootNamespace>EntitySpaces.TemplateUI</RootNamespace>
    <AssemblyName>EntitySpaces.TemplateUI</AssemblyName>
    
    <!-- Firmado de ensamblado -->
    <!--<SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\StrongNameKey\EntitySpaces.snk</AssemblyOriginatorKeyFile>-->
    
    <!-- Desactivado para evitar conflictos con Properties\AssemblyInfo.cs y SharedVersion.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EntitySpaces.AddIn.TemplateUI\EntitySpaces.AddIn.TemplateUI.csproj" />
    <ProjectReference Include="..\EntitySpaces.MetadataEngine\EntitySpaces.MetadataEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mantenemos los archivos vinculados (links) -->
    <Compile Include="..\..\SharedFiles\SharedVersion.cs" Link="SharedVersion.cs" />
    <!--<None Include="..\StrongNameKey\EntitySpaces.snk" Link="EntitySpaces.snk" />-->
  </ItemGroup>

  <!-- Opcional: Solo si notas que Properties\Resources.resx no se regenera correctamente 
       (aunque el SDK suele manejar esto en automático, a veces es necesario forzar la dependencia del Designer) -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>