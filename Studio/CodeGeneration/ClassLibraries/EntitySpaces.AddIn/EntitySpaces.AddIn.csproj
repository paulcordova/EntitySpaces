<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Library</OutputType>
	<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
	<TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
	<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    
    <!-- El nombre del ensamblado que StandAlone estaba buscando -->
    <RootNamespace>EntitySpaces.AddIn</RootNamespace>
    <AssemblyName>EntitySpaces2026.AddIn</AssemblyName>
    
    <ApplicationIcon>default.ico</ApplicationIcon>
    <!--<SignAssembly>true</SignAssembly>-->
    <!--<AssemblyOriginatorKeyFile>..\..\StrongNameKey\EntitySpaces.snk</AssemblyOriginatorKeyFile>-->
    
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<NoWarn>$(NoWarn);NU1701</NoWarn>
	<PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <!-- Archivos compartidos (Linked files) -->
  <ItemGroup>
    <Compile Include="..\..\SharedFiles\Crypto.cs" Link="Crypto.cs" />
    <Compile Include="..\..\SharedFiles\Licensing.cs" Link="Licensing.cs" />
    <Compile Include="..\..\SharedFiles\NativeMethods.cs" Link="NativeMethods.cs" />
    <Compile Include="..\..\SharedFiles\SecurityTest.cs" Link="SecurityTest.cs" />
    <Compile Include="..\..\SharedFiles\SharedVersion.cs" Link="SharedVersion.cs" />
  </ItemGroup>

  <!-- Referencias a otros proyectos hermanos -->
  <ItemGroup>
    <ProjectReference Include="..\EntitySpaces.AddIn.TemplateUI\EntitySpaces.AddIn.TemplateUI.csproj" />
    <ProjectReference Include="..\EntitySpaces.CodeGenerator\EntitySpaces.CodeGenerator.csproj" />
    <ProjectReference Include="..\EntitySpaces.Common\EntitySpaces.Common.csproj" />
    <ProjectReference Include="..\EntitySpaces.MetadataEngine\EntitySpaces.MetadataEngine.csproj" />
  </ItemGroup>

	<!-- Dependencias de Extensibilidad y UI -->
	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.SDK.EmbedInteropTypes" />
		<PackageReference Include="stdole" />
		<PackageReference Include="System.Management" />
		<PackageReference Include="WeifenLuo.WinFormsUI.Docking" />
	</ItemGroup>

  <!-- Archivos de contenido e iconos consolidados con comodines -->
  <ItemGroup>
    <Content Include="AddIn\EntitySpaces2012.AddIn" />
    <Content Include="default.ico" />
    <Content Include="esIcon.ico" />
    <Content Include="Icons\**\*.png" />
    <Compile Remove="MetaProperties.cs" />
    <EmbeddedResource Remove="MetaProperties.resx" />
    
    <None Include="..\..\StrongNameKey\EntitySpaces.snk" Link="EntitySpaces.snk" />
  </ItemGroup>

  <!-- Recursos con generadores de código personalizados -->
  <ItemGroup>
    <Compile Update="CommandBar.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CommandBar.resx</DependentUpon>
    </Compile>
    <Compile Update="Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>

    <EmbeddedResource Update="CommandBar.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>CommandBar.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>